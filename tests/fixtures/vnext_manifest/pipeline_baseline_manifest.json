        "ports": [
          {
            "name": "summary",
            "type": "markdown",
            "description": "研究摘要",
            "required": true
          }
        ]
      },
      "acceptance_criteria": [
        "列出 llm/tool/sandbox 基線",
        "標示目前 fallback 行為"
