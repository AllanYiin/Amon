        ]
      },
      "acceptance_criteria": [
        "回傳 deterministic tool 結果"
      ],
      "side_effect_class": "read_only",
      "status": "active",
      "created_at": "2026-01-01T00:00:00Z",
      "updated_at": "2026-01-01T00:00:00Z"
    },
